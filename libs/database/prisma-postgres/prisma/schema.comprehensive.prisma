// prisma/schema.prisma
//
// Comprehensive Prisma schema for "Do Something" system
// This demonstrates the complete database model architecture
//
// Parts:
// 1. Datasource & Generator
// 2. Shared Models (User, BaseEntity)
// 3. Business Domain Models
// 4. Cinema Domain Models (example for MongoDB services)
// 5. Event Domain Models
// 6. Admin Models
// 7. Indexes & Constraints

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ============================================================================
// SHARED MODELS (Used across all services)
// ============================================================================

/**
 * User Model
 * Shared across all services for authentication & authorization
 * Features:
 * - JWT-based authentication
 * - RBAC with roles
 * - Email verification
 * - 2FA support
 */
model User {
    id           String  @id @default(cuid())
    email        String  @unique
    password     String // hashed with pbkdf2
    firstName    String
    lastName     String
    phone        String?
    profileImage String?

    // Authentication
    isVerified           Boolean   @default(false)
    verificationToken    String?
    verificationTokenExp DateTime?

    // 2FA
    twoFactorEnabled Boolean @default(false)
    twoFactorSecret  String?

    // Password reset
    resetToken          String?
    resetTokenExpiresAt DateTime?

    // Status
    status UserStatus @default(ACTIVE) // ACTIVE, INACTIVE, BANNED

    // Authorization
    roles       String[] @default(["USER"]) // USER, ADMIN, MODERATOR
    permissions String[] @default([])

    // Timestamps
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    deletedAt   DateTime? // Soft delete
    lastLoginAt DateTime?

    // Relations
    businessProducts Product[]
    businessOrders   Order[]
    businessReviews  Review[]
    cinemaBookings   CinemaBooking[]
    eventTickets     EventTicket[]
    socialPosts      SocialPost[]
    socialFollowers  SocialFollow[]  @relation("follower")
    socialFollowing  SocialFollow[]  @relation("following")

    @@index([email])
    @@index([status])
    @@index([createdAt])
}

enum UserStatus {
    ACTIVE
    INACTIVE
    BANNED
    SUSPENDED
}

// ============================================================================
// BUSINESS DOMAIN MODELS
// ============================================================================

/**
 * Product Model
 * Core product catalog with inventory tracking
 * Supports:
 * - Multiple categories
 * - SKU-based inventory
 * - Product variants (versions)
 * - Reviews & ratings
 */
model Product {
    id String @id @default(cuid())

    // Basic info
    sku              String  @unique // Stock Keeping Unit
    name             String  @unique
    description      String  @db.Text
    shortDescription String?

    // Pricing & Inventory
    price            Decimal  @db.Decimal(10, 2) // $9,999.99
    costPrice        Decimal? @db.Decimal(10, 2) // For margin calculation
    inventory        Int // Total quantity available
    reservedQuantity Int      @default(0) // Reserved by pending orders

    // Meta
    categoryId String
    category   Category @relation(fields: [categoryId], references: [id])
    imageUrl   String?
    imageUrls  String[] // Gallery
    tags       String[] // For searching

    // Status
    status   ProductStatus @default(ACTIVE) // ACTIVE, INACTIVE, DISCONTINUED
    isHidden Boolean       @default(false)

    // Stats
    viewCount     Int     @default(0)
    purchaseCount Int     @default(0)
    averageRating Decimal @default(0) @db.Decimal(3, 2)

    // Author
    createdById String
    createdBy   User   @relation(fields: [createdById], references: [id])

    // Timestamps
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime? // Soft delete

    // Relations
    orderItems OrderItem[]
    reviews    Review[]
    inventory  Inventory?

    @@index([categoryId])
    @@index([createdById])
    @@index([status])
    @@index([createdAt])
    @@index([sku])
}

enum ProductStatus {
    ACTIVE
    INACTIVE
    DISCONTINUED
    OUT_OF_STOCK
}

/**
 * Category Model
 * Product categorization with hierarchical support
 */
model Category {
    id          String  @id @default(cuid())
    name        String
    slug        String  @unique
    description String?
    imageUrl    String?

    // Hierarchy
    parentId String?
    parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
    children Category[] @relation("SubCategories")

    // Display
    displayOrder Int     @default(0)
    isActive     Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    products Product[]

    @@index([slug])
    @@index([parentId])
}

/**
 * Inventory Model
 * Detailed inventory tracking for products
 */
model Inventory {
    id        String  @id @default(cuid())
    productId String  @unique
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    // Tracking
    totalStock     Int
    availableStock Int
    reservedStock  Int @default(0)
    damagedStock   Int @default(0)

    // Warehouse locations
    warehouseLocation String?
    binNumber         String?

    // Reorder
    reorderLevel    Int       @default(10)
    reorderQuantity Int       @default(100)
    lastRestocked   DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    movements InventoryMovement[]

    @@index([productId])
}

/**
 * Inventory Movement
 * Audit trail for inventory changes
 */
model InventoryMovement {
    id          String    @id @default(cuid())
    inventoryId String
    inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

    // Movement details
    type        MovementType // IN, OUT, ADJUSTMENT, DAMAGE
    quantity    Int
    reason      String?
    referenceId String? // Order ID, Return ID, etc

    createdAt DateTime @default(now())

    @@index([inventoryId])
    @@index([referenceId])
}

enum MovementType {
    IN
    OUT
    ADJUSTMENT
    DAMAGE
    RETURN
}

/**
 * Order Model
 * Comprehensive order management with status tracking
 */
model Order {
    id String @id @default(cuid())

    // Order info
    orderNumber String @unique @db.VarChar(50) // e.g., "ORD-2024-001234"
    userId      String
    user        User   @relation(fields: [userId], references: [id])

    // Amounts
    subtotal       Decimal @db.Decimal(12, 2)
    taxAmount      Decimal @default(0) @db.Decimal(12, 2)
    shippingCost   Decimal @default(0) @db.Decimal(12, 2)
    discountAmount Decimal @default(0) @db.Decimal(12, 2)
    totalAmount    Decimal @db.Decimal(12, 2)

    // Status
    status        OrderStatus   @default(PENDING) // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
    paymentStatus PaymentStatus @default(UNPAID) // UNPAID, PENDING, PAID, REFUNDED

    // Shipping
    shippingAddress        Address   @relation("ShippingAddress")
    billingAddress         Address   @relation("BillingAddress")
    shippingTrackingNumber String?
    estimatedDeliveryDate  DateTime?

    // Notes
    notes         String?
    internalNotes String?

    // Timestamps
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    deletedAt   DateTime? // Soft delete
    confirmedAt DateTime?
    shippedAt   DateTime?
    deliveredAt DateTime?
    cancelledAt DateTime?

    // Relations
    items    OrderItem[]
    payment  Payment?
    returns  OrderReturn[]
    timeline OrderTimeline[]

    @@index([userId])
    @@index([status])
    @@index([paymentStatus])
    @@index([createdAt])
}

enum OrderStatus {
    PENDING
    CONFIRMED
    PROCESSING
    SHIPPED
    DELIVERED
    CANCELLED
    FAILED
}

enum PaymentStatus {
    UNPAID
    PENDING
    PAID
    REFUNDED
    FAILED
}

/**
 * Order Item
 * Individual items in an order
 */
model OrderItem {
    id      String @id @default(cuid())
    orderId String
    order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    productId String
    product   Product @relation(fields: [productId], references: [id])

    // Item details
    quantity  Int
    unitPrice Decimal @db.Decimal(10, 2)
    subtotal  Decimal @db.Decimal(12, 2)
    discount  Decimal @default(0) @db.Decimal(10, 2)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([orderId])
    @@index([productId])
}

/**
 * Address Model
 * Shared for shipping and billing addresses
 */
model Address {
    id String @id @default(cuid())

    // Address details
    street  String
    city    String
    state   String
    zipCode String
    country String

    // Phone & Email
    phone String
    note  String?

    // Relations
    orderShipping   Order?  @relation("ShippingAddress", fields: [shippingOrderId], references: [id])
    shippingOrderId String? @unique

    orderBilling   Order?  @relation("BillingAddress", fields: [billingOrderId], references: [id])
    billingOrderId String? @unique

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

/**
 * Payment Model
 * Payment processing and history
 */
model Payment {
    id      String @id @default(cuid())
    orderId String @unique
    order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    // Payment details
    amount Decimal       @db.Decimal(12, 2)
    method PaymentMethod // CREDIT_CARD, DEBIT_CARD, BANK_TRANSFER, EWALLET
    status PaymentStatus @default(UNPAID)

    // Transaction
    transactionId  String? @unique // From payment gateway
    transactionRef String?

    // Card info (if applicable)
    cardLast4 String?
    cardBrand String?

    // Timestamps
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    processedAt   DateTime?
    failedAt      DateTime?
    failureReason String?

    @@index([orderId])
    @@index([status])
}

enum PaymentMethod {
    CREDIT_CARD
    DEBIT_CARD
    BANK_TRANSFER
    EWALLET
    CASH_ON_DELIVERY
    INSTALLMENT
}

/**
 * Order Return
 * Handling order returns and refunds
 */
model OrderReturn {
    id      String @id @default(cuid())
    orderId String
    order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    // Return details
    reason      ReturnReason
    description String?
    quantity    Int

    // Refund
    refundAmount      Decimal      @db.Decimal(12, 2)
    refundStatus      RefundStatus @default(PENDING)
    refundProcessedAt DateTime?

    // Status
    status ReturnStatus @default(INITIATED) // INITIATED, APPROVED, RETURNED, REFUNDED, REJECTED

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([orderId])
    @@index([status])
}

enum ReturnReason {
    DEFECTIVE
    NOT_AS_DESCRIBED
    CHANGED_MIND
    DAMAGED_IN_SHIPPING
    WRONG_ITEM
    DUPLICATE_ORDER
    OTHER
}

enum ReturnStatus {
    INITIATED
    APPROVED
    RETURNED
    REFUNDED
    REJECTED
}

enum RefundStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
}

/**
 * Review & Rating
 * Customer reviews and ratings for products
 */
model Review {
    id        String  @id @default(cuid())
    productId String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation(fields: [userId], references: [id])

    // Review content
    rating    Int // 1-5 stars
    title     String?
    content   String   @db.Text
    imageUrls String[] // Photos of product

    // Stats
    helpfulCount   Int @default(0)
    unhelpfulCount Int @default(0)

    // Status
    isVerifiedPurchase Boolean      @default(false)
    status             ReviewStatus @default(PENDING) // PENDING, APPROVED, REJECTED, HIDDEN

    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
    approvedAt DateTime?

    @@index([productId])
    @@index([userId])
    @@index([status])
    @@index([createdAt])
}

enum ReviewStatus {
    PENDING
    APPROVED
    REJECTED
    HIDDEN
}

/**
 * Order Timeline
 * Track status changes for order auditing
 */
model OrderTimeline {
    id      String @id @default(cuid())
    orderId String
    order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    event     OrderEvent
    details   String?
    createdAt DateTime   @default(now())

    @@index([orderId])
    @@index([event])
}

enum OrderEvent {
    CREATED
    CONFIRMED
    PAYMENT_RECEIVED
    PAYMENT_FAILED
    PROCESSING
    SHIPPED
    DELIVERED
    CANCELLED
    RETURNED
    REFUNDED
}

// ============================================================================
// CINEMA DOMAIN MODELS (For MongoDB services)
// These are documented here but would be in separate MongoDB schema
// ============================================================================

/**
 * Movie Model
 * ⚠️  For Cinema, Sport, Social - Use MongoDB instead of PostgreSQL
 * In MongoDB (Mongoose):
 * @Schema()
 * export class Movie {
 * @Prop({ required: true })
 * title: string;
 * @Prop({ required: true })
 * director: string;
 * // ... etc
 * }
 */

// ============================================================================
// EVENT DOMAIN MODELS
// ============================================================================

/**
 * Event Model
 * Event management for conferences, concerts, etc
 */
model Event {
    id String @id @default(cuid())

    // Event info
    title       String
    description String @db.Text
    slug        String @unique

    // Dates
    startDate             DateTime
    endDate               DateTime
    registrationStartDate DateTime?
    registrationEndDate   DateTime?

    // Location
    venue   String?
    address String?
    city    String?
    state   String?
    country String?

    // Capacity
    totalCapacity   Int
    registeredCount Int @default(0)

    // Pricing
    isFree    Boolean  @default(false)
    basePrice Decimal? @db.Decimal(10, 2)

    // Status
    status EventStatus @default(DRAFT) // DRAFT, PUBLISHED, ONGOING, COMPLETED, CANCELLED

    // Media
    imageUrl  String?
    bannerUrl String?

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    publishedAt DateTime?

    // Relations
    tickets    EventTicket[]
    categories EventCategory[]

    @@index([status])
    @@index([startDate])
    @@index([createdAt])
}

enum EventStatus {
    DRAFT
    PUBLISHED
    ONGOING
    COMPLETED
    CANCELLED
}

/**
 * Event Ticket Model
 * Ticket allocation and sales for events
 */
model EventTicket {
    id      String @id @default(cuid())
    eventId String
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation(fields: [userId], references: [id])

    // Ticket details
    ticketNumber String  @unique
    qrCode       String? // QR code for entry
    ticketType   String // VIP, STANDARD, ECONOMY

    // Validation
    isUsed Boolean   @default(false)
    usedAt DateTime?

    // Price
    price Decimal @db.Decimal(10, 2)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([eventId])
    @@index([userId])
    @@index([isUsed])
}

/**
 * Event Category
 * Categorization for events
 */
model EventCategory {
    id      String @id @default(cuid())
    eventId String
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

    categoryName String

    @@unique([eventId, categoryName])
    @@index([eventId])
}

// ============================================================================
// SOCIAL DOMAIN MODELS (For MongoDB)
// ============================================================================

/**
 * Social Post Model
 * ⚠️  Use MongoDB for Social service
 * In MongoDB:
 * @Schema()
 * export class SocialPost {
 * @Prop()
 * content: string;
 * @Prop()
 * authorId: string;
 * @Prop({ default: 0 })
 * likeCount: number;
 * }
 */

// ============================================================================
// SOCIAL FOLLOW MODEL (Can be in PostgreSQL)
// ============================================================================

model SocialFollow {
    id String @id @default(cuid())

    followerId String
    follower   User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)

    followingId String
    following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([followerId, followingId])
    @@index([followerId])
    @@index([followingId])
}

/**
 * Cinema Booking Model
 * For cinema showtime bookings
 */
model CinemaBooking {
    id String @id @default(cuid())

    userId String
    user   User   @relation(fields: [userId], references: [id])

    // Booking details
    showtimeId  String
    seatsBooked String[] // ["A1", "A2", "B1"]

    // Status
    status BookingStatus @default(CONFIRMED) // CONFIRMED, CANCELLED

    // Payment
    totalPrice Decimal @db.Decimal(10, 2)

    // QR Code
    qrCode String?

    createdAt   DateTime  @default(now())
    cancelledAt DateTime?

    @@index([userId])
}

enum BookingStatus {
    CONFIRMED
    CANCELLED
    CHECKED_IN
    EXPIRED
}

// ============================================================================
// INDEXES & CONSTRAINTS
// ============================================================================

/**
 * Important indexes for performance:
 * - Foreign keys (automatic)
 * - Status fields (filtering)
 * - Timestamps (sorting)
 * - Unique fields
 * Run migrations:
 * npx prisma migrate dev --name <migration-name>
 * Generate Prisma Client:
 * npx prisma generate
 */
